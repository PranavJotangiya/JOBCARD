# Dependencies
node_modules/

# Build output
dist/
build/
frontend/.angular/
*.tsbuildinfo

# Environment — never commit real secrets, but keep the *.example templates
.env
.env.*
!.env.example
!.env.*.example

# Uploaded files (local dev file storage) — keep the folder, ignore its contents
backend/uploads/*
!backend/uploads/.gitkeep

# Logs
logs/
*.log
npm-debug.log*

# Test / coverage
coverage/
.nyc_output/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Misc
*.pem
