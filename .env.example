# ---------------------------------------------------------------------------
# JOBCARD — root env reference.
# Backend reads backend/.env  •  Frontend reads src/environments/*.
# Copy backend/.env.example -> backend/.env and fill in real values.
# NEVER commit real .env files.
# ---------------------------------------------------------------------------

# Backend
NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/jobcard?retryWrites=true&w=majority
CLIENT_URL=http://localhost:4200
AUTH_SECRET=replace-with-a-long-random-string

# Frontend (build-time; see frontend/src/environments/environment*.ts)
API_BASE_URL=http://localhost:3000/api/v1
