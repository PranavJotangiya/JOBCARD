# ---------------------------------------------------------------------------
# JOBCARD API — PRODUCTION environment (Render / any Node host)
# Set these as the host's environment variables. Do NOT commit a filled copy.
# ---------------------------------------------------------------------------
NODE_ENV=production
PORT=3000                       # Render injects its own PORT; the app respects it
API_PREFIX=/api/v1

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/jobcard?retryWrites=true&w=majority
MONGODB_DB_NAME=jobcard

# The EXACT frontend origin(s), comma-separated. No trailing slash.
# Firebase Hosting gives you both of these; add a custom domain if you have one.
CLIENT_URL=https://<your-project>.web.app,https://<your-project>.firebaseapp.com

# Strong random secret — REQUIRED. Weak/placeholder values are rejected in prod.
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=

# Cross-site cookies: the API (Render) and the app (Firebase) are different
# origins, so the browser needs SameSite=None + Secure to send the auth cookies.
COOKIE_SECURE=true
COOKIE_SAMESITE=none
# COOKIE_DOMAIN=                 # leave empty unless API + app share a parent domain

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
BCRYPT_SALT_ROUNDS=12

# File storage. `local` is fine within one container lifetime; the disk is wiped
# on redeploy on hosts without a persistent volume. Add an S3 driver for durable
# pattern-image storage (see backend/src/modules/files/storage/).
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=uploads
MAX_UPLOAD_MB=8

LOG_LEVEL=info
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
REQUEST_BODY_LIMIT=1mb
