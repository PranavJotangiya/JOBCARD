# ---------------------------------------------------------------------------
# JOBCARD API — Environment Configuration
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# Runtime: development | test | production
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# ---------------------------------------------------------------------------
# MongoDB Atlas — https://www.mongodb.com/cloud/atlas
# mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority
# ---------------------------------------------------------------------------
MONGODB_URI=
MONGODB_DB_NAME=jobcard

# ---------------------------------------------------------------------------
# CORS — comma-separated list of allowed frontend origins.
# ---------------------------------------------------------------------------
CLIENT_URL=http://localhost:4200

# ---------------------------------------------------------------------------
# Authentication
# AUTH_SECRET is the primary knob. The access/refresh secrets default to values
# derived from it; override them only if you need independent rotation.
# Generate:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ---------------------------------------------------------------------------
AUTH_SECRET=change-me-please-use-a-long-random-string
AUTH_ACCESS_SECRET=
AUTH_REFRESH_SECRET=
COOKIE_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
BCRYPT_SALT_ROUNDS=12

# Cookie flags — set COOKIE_SECURE=true and COOKIE_DOMAIN in production (HTTPS).
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# ---------------------------------------------------------------------------
# File storage (pattern images). driver: local | (s3/gcs later)
# ---------------------------------------------------------------------------
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=uploads
MAX_UPLOAD_MB=8

# ---------------------------------------------------------------------------
# Logging & limits
# ---------------------------------------------------------------------------
LOG_LEVEL=info
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
REQUEST_BODY_LIMIT=1mb
